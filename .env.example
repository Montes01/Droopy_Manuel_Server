# Variables de entorno del backend.
#
# Puerto donde escucha la API (por defecto 3100).
# El 3000 y 3001 suelen estar ocupados por otras herramientas en Windows, por
# eso el valor por defecto es 3100. El frontend usa esta misma URL en desarrollo.
PORT=3100

# Conexión a PostgreSQL.
#
# El puerto 2121 es el del contenedor de `docker-compose.yml`, elegido para no
# chocar con el PostgreSQL nativo de Windows (5432) ni con otros proyectos.
DATABASE_URL=postgresql://droopy:droopy@localhost:2121/droopy_manuel

# Token para escribir en /api/admin desde scripts o CI.
#
# Es opcional y distinto de las sesiones del panel: no identifica a nadie, así
# que la auditoría lo registra sin usuario. Debe tener al menos 16 caracteres;
# si está vacío o es corto, esa vía de acceso queda deshabilitada.
# ADMIN_TOKEN=cambia-esto-por-algo-largo-y-aleatorio

# Orígenes permitidos por CORS, separados por coma.
# En desarrollo el frontend de SvelteKit corre en el 5173, ya incluido por
# defecto. En producción añade aquí tu dominio real.
# PUBLIC_ORIGINS=https://droopymanuel.co,https://www.droopymanuel.co

# En producción activa la cookie de sesión como `secure` (solo HTTPS).
# NODE_ENV=production
